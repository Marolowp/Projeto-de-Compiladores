PARSER_BEGIN(TrabalhoComp)
import java.io.*;
public class TrabalhoComp {

  public static void main(String args[])
            throws ParseException, IOException {

        if (args.length == 0) {
            System.out.println(
                "Informe o arquivo de entrada."
            );
            return;
        }

        TrabalhoComp analisador = new TrabalhoComp(
            new FileInputStream(args[0])
        );

        analisador.TrabalhoComp();

        System.out.println(
            "Programa sintaticamente correto!"
        );
    }

}

PARSER_END(TrabalhoComp)

SKIP :
{
  " "
| "\t"
| "\n"
| "\r"
}

/* palavras reservadas */
TOKEN :
{
  <MAIN: "main">
| <VAR: "var">
| <INT: "int">
| <BOOL: "bool">
| <IF: "if">
| <WHILE: "while">
| <DO: "do">
| <RETURN: "return">
| <PRINT: "print">
| <FUNCTION: "function">
| <TRUE: "true">
| <FALSE: "false">
}

/* simbolos */
TOKEN :
{
  <ACHAVES: "{">
| <FCHAVES: "}">
| <APARENTESES: "(">
| <FPARENTESES: ")">
| <PTVIRGULA: ";">
| <VIRGULA: ",">
| <ATRIBUICAO: ":=">
}

/* operadores */
TOKEN :
{
  <SOMA: "+">
| <SUB: "-">
| <MULT: "*">
| <DIV: "/">
| <AND: "&&">
| <OR: "||">
| <MENOR: "<">
| <MAIOR: ">">
| <IGUAL: "==">
}

/* identificadores e numeros */
TOKEN :
{
  <NUM: <DIGITOS> (<FRACAO>)? (<EXPOENTE>)?>
| <ID: <LETRA> (<LETRAOUDIGITO>)* (<FINALSUBLINHADO>)*>
| <#LETRA: ["a"-"z","A"-"Z"]>
| <#DIGITO: ["0"-"9"]>
| <#DIGITOS: (<DIGITO>)+>
| <#LETRAOUDIGITO: <LETRA> | <DIGITO>>
| <#FRACAO: "." <DIGITOS>>
| <#EXPOENTE: "E" (["+","-"])? <DIGITOS>>
| <#FINALSUBLINHADO: "_" (<LETRAOUDIGITO>)+>
}

// LUGOSI -> MAIN FUNC?
// A regra recursiva de FUNC é representada por repetição.

void TrabalhoComp() :
{}
{
    Main()
    ( Funcao() )*
    <EOF>
}

void Main() :
{}
{
    <MAIN>
    <ACHAVES>
    Declaracoes()
    Comandos()
    <FCHAVES>
}

void Declaracoes() :
{}
{
    (
        <VAR>
        Tipo()
        <ID>
        <PTVIRGULA>
    )*
}

void Tipo() :
{}
{
    <INT>
  | <BOOL>
}

void Comandos() :
{}
{
    ( Comando() )*
}

void Comando() :
{}
{
    LOOKAHEAD(2)
    <ID>
    <ATRIBUICAO>
    Expressao()
    <PTVIRGULA>

  |
    LOOKAHEAD(2)
    <ID>
    <APARENTESES>
    ListaExpressaoOpcional()
    <FPARENTESES>
    <PTVIRGULA>

  |
    <IF>
    <APARENTESES>
    Expressao()
    <FPARENTESES>
    <ACHAVES>
    Comandos()
    <FCHAVES>
    <PTVIRGULA>

  |
    <WHILE>
    <APARENTESES>
    Expressao()
    <FPARENTESES>
    <DO>
    <ACHAVES>
    Comandos()
    <FCHAVES>
    <PTVIRGULA>

  |
    <DO>
    <ACHAVES>
    Comandos()
    <FCHAVES>
    <WHILE>
    <APARENTESES>
    Expressao()
    <FPARENTESES>
    <PTVIRGULA>

  |
    <RETURN>
    Expressao()
    <PTVIRGULA>

  |
    <PRINT>
    <APARENTESES>
    Expressao()
    <FPARENTESES>
    <PTVIRGULA>
}

void Expressao() :
{}
{
      <APARENTESES>
      Expressao()
      Operador()
      Expressao()
      <FPARENTESES>

    | Fator()
}

void Operador() :
{}
{
      <SOMA>
    | <SUB>
    | <MULT>
    | <DIV>
    | <AND>
    | <OR>
    | <MENOR>
    | <MAIOR>
    | <IGUAL>
}

void Fator() :
{}
{
      LOOKAHEAD(2)
      <ID>
      <APARENTESES>
      ListaExpressaoOpcional()
      <FPARENTESES>

    | <ID>
    | <NUM>
    | <TRUE>
    | <FALSE>
}

void ListaExpressaoOpcional() :
{}
{
    [ ListaExpressao() ]
}

void ListaExpressao() :
{}
{
    Expressao()
    (
        <VIRGULA>
        Expressao()
    )*
}

void Funcao() :
{}
{
    <FUNCTION>
    Tipo()
    <ID>
    <APARENTESES>
    ListaArgumentosOpcional()
    <FPARENTESES>
    <ACHAVES>
    Declaracoes()
    Comandos()
    <FCHAVES>
}

void ListaArgumentosOpcional() :
{}
{
    [ ListaArgumentos() ]
}

void ListaArgumentos() :
{}
{
    Tipo()
    <ID>
    (
        <VIRGULA>
        Tipo()
        <ID>
    )*
}
